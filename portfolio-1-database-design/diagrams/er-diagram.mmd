erDiagram
    STATE ||--o{ CUSTOMER : "resides in"
    CUSTOMER ||--|{ ACCOUNT : owns
    ACCOUNT_TYPE ||--o{ ACCOUNT : classifies
    CUSTOMER ||--o{ BENEFICIARY : saves
    ACCOUNT ||--o{ BENEFICIARY : "is saved as"
    TXN ||--|{ LEDGER_ENTRY : "posted as"
    ACCOUNT ||--o{ LEDGER_ENTRY : "debited/credited by"
    TXN |o--o| TXN : reverses

    STATE {
        char2 state_code PK
        varchar state_name UK
        varchar geo_zone
    }
    ACCOUNT_TYPE {
        varchar type_code PK
        varchar description
        numeric daily_limit
        numeric interest_rate
        boolean is_internal
    }
    CUSTOMER {
        bigint customer_id PK
        char11 bvn UK
        varchar first_name
        varchar last_name
        varchar email UK
        varchar phone UK
        date date_of_birth
        smallint kyc_tier
        char2 state_code FK
        timestamptz created_at
    }
    ACCOUNT {
        bigint account_id PK
        char10 account_number UK
        bigint customer_id FK
        varchar type_code FK
        char3 currency
        numeric balance
        varchar status
        timestamptz opened_at
    }
    TXN {
        bigint txn_id PK
        uuid reference UK
        varchar txn_type
        varchar status
        numeric amount
        varchar channel
        varchar narration
        bigint reverses_txn_id FK
        timestamptz created_at
        timestamptz completed_at
    }
    LEDGER_ENTRY {
        bigint entry_id PK
        bigint txn_id FK
        bigint account_id FK
        char1 direction
        numeric amount
        numeric balance_after
        timestamptz created_at
    }
    BENEFICIARY {
        bigint customer_id PK,FK
        bigint account_id PK,FK
        varchar nickname
        timestamptz added_at
    }
    STAFF {
        int staff_id PK
        varchar full_name
        varchar role
        varchar email UK
    }
    AUDIT_LOG {
        bigint audit_id PK
        varchar table_name
        bigint record_id
        varchar action
        jsonb old_data
        jsonb new_data
        text changed_by
        timestamptz changed_at
    }
